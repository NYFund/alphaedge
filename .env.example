# AlphaEdge 環境變數範本
# -----------------------------------------------------------------------
# 用法：cp .env.example .env，再依需求填寫。`.env` 已列入 .gitignore，切勿提交。
#
# 標示「選填」的鍵以註解形式列出，不需要時保持註解即可。
# 取消註解卻留空值時，部分鍵會讀到空字串而不是「未設定」，行為不一定相同。
#
# 本檔的鍵與程式實際讀取的環境變數由 tests/test_config_consistency.py 雙向核對。
# -----------------------------------------------------------------------


# === DolphinDB（只有 tick 資料需要；沒有 DolphinDB 的機器可以不填） ===
DDB_PATH=dfs://
DDB_HOST=localhost
DDB_PORT=8848
DDB_USER=admin
DDB_PASSWORD=your_password_here


# === Shioaji API ===
API_KEY=your_api_key
API_SECRET_KEY=your_api_secret_key

# （選填）tick 爬蟲的多帳號輪替，組數對應 core/config/settings.py 的 NUM_API。
# 未設定的組別讀到的是 None
# API_KEY_1=
# API_SECRET_KEY_1=
# API_KEY_2=
# API_SECRET_KEY_2=
# API_KEY_3=
# API_SECRET_KEY_3=
# API_KEY_4=
# API_SECRET_KEY_4=


# === FinMind API ===
FINMIND_API_TOKEN=your_finmind_api_token


# === （選填）Shioaji 下單憑證（CA）：只有實盤下單需要 ===
# 正式環境下單前必須 activate_ca()；模擬環境預設不啟用，不必填。
# **憑證檔請放專案目錄以外**（例如 ~/.alphaedge/ca/），避免被 git 或容器映像帶走。
# 未設定時為 None，實際要下單的地方會以 require_shioaji_ca() 當場拋出
# SHIOAJI_CA_PATH=~/.alphaedge/ca/Sinopac.pfx
# SHIOAJI_CA_PASSWORD=
# 一張憑證對應多個帳號時才需要指定身分證字號
# SHIOAJI_PERSON_ID=


# === （選填）實盤交易 ===
# 刻意沒有「連正式環境」的環境變數：正式環境只能由命令列
# `--production --confirm-production` 開啟，避免 .env 殘留設定讓排程默默連上去。
#
# kill switch：檔案存在即停止送單。未設定時為 data/live/KILL_SWITCH
# ALPHAEDGE_LIVE_KILL_SWITCH_PATH=
# 事件通知管道（第一階段只實作 telegram）。三個鍵缺任一即退化為不推播，
# 但啟動時會 log 警告並寫進 live_run——不可靜默，否則會以為有告警其實沒有
# ALPHAEDGE_LIVE_NOTIFY_CHANNEL=telegram
# ALPHAEDGE_LIVE_NOTIFY_TOKEN=
# ALPHAEDGE_LIVE_NOTIFY_TARGET=


# === （選填）執行期產物根目錄 ===
# 未設定時分別為專案根目錄下的 data/、results/、logs/；容器掛載 volume 時用來覆寫。
# 前端讀的也是 ALPHAEDGE_RESULTS_DIR：後端寫到哪、前端就讀哪
# ALPHAEDGE_DATA_DIR=
# ALPHAEDGE_RESULTS_DIR=
# ALPHAEDGE_LOGS_DIR=
# 舊名，前端仍相容並會發出警告；新設定請改用 ALPHAEDGE_RESULTS_DIR
# ALPHAEDGE_BACKTEST_RESULTS=


# === （選填）回測報表 ===
# 設為 1／true／yes／on 時，回測畫完圖會在瀏覽器開啟（等同 run.py --show）；預設不開
# ALPHAEDGE_SHOW_FIGURES=
