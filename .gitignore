# Byte-compiled / optimized / DLL files
__pycache__/
*pyc

# Environments
.venv/
.env
.env.*
!.env.example


# 執行期產物：程式寫出來的東西一律在這三個目錄底下，`core/` 只放原始碼
data/
results/
logs/

# 研究產物：strategy_lab 各研究自己的 output/，不與主線的 results/ 混放
strategy_lab/**/output/

# 同上，但報告產出物寫在 reports/ 而不是 output/：各研究的 `generate_docx.py`
# 不傳輸出路徑時預設就寫進自己那個 reports/ 目錄，跑一次就是幾 MB 的二進位 diff。
# `check-added-large-files` 擋不住已經進版控的檔案（它只檢查新加入的檔案）
strategy_lab/**/reports/*.docx

# 測試產物：fixture 資料庫、下載暫存、一次性比對輸出
tests/database/
tests/downloads/
tests/temp/
tests/backtest/cost_formula_diff.csv

# 上面四條原本是被全 repo 的 `*.csv`／`*.png` 封鎖順手蓋掉的。改成逐項列出後，
# 每一條都說得出是什麼、為什麼不進版控——而 tests/backtest/snapshots/*.csv
# （回歸護欄）也不再需要一條負向例外把它從封鎖中撈回來

# Shioaji（第三方套件會往當時的工作目錄寫，擋不住來源只能擋檔名）
shioaji.log

# 長時間回補的 nohup 輸出（權益變動表那次 34 小時就是 13 MB）。
# 同樣的內容 LogManager 已寫進 logs/ 的檔案 sink，這份只是為了好 grep
backfill_*.log

# Downloads Content
Downloads/*

# MkDocs
site/
.cache/

# macOS / 編輯器產物
# 不要只依賴 global gitignore——協作者的全域設定不會跟著 repo 走
.DS_Store
.idea/
*.swp

# Build & Coverage
# egg-info 由 `pip install -e .` 產生；.coverage 由 pytest --cov 產生。
# ruff 與 pytest 的 cache 目錄會自行寫入 .gitignore 自我排除，不需列在這裡
*.egg-info/
.coverage

# 個人 notebook：常拿來貼金鑰做臨時測試，不可進版控
*.ipynb
